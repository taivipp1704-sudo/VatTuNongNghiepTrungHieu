{
  "name": "@agristock/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.local/api.env dist/main.js",
    "seed": "node --env-file-if-exists=../../.local/api.env dist/seed.js",
    "provision": "node dist/provision.js",
    "test": "node --test --test-concurrency=1 dist/integration.test.js dist/provision.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "~5.9.2"
  }
}
