{
  "expo": {
    "name": "HTAgri",
    "slug": "agristock-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agristock",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "vn.agristock.internal",
      "supportsTablet": true
    },
    "android": {
      "package": "vn.agristock.internal",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#057E74",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F5EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phÃ©p HTAgri quÃ©t mÃ£ sáº£n pháº©m.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
